# Build artifacts (regenerable via project.yml + xcodegen)
build/
DerivedData/
*.xcuserstate
xcuserdata/
.DS_Store

# Xcode project is generated by XcodeGen from project.yml — keep the generated
# project out of version control to avoid churn; regenerate with `xcodegen generate`.
Brinkball.xcodeproj/

# Signing artifact (not a secret, but not needed to build from source)
assets/*.mobileprovision

# Tool logs
*.log
assets/*.log

# Claude Code session metadata
.claude/

# Raw debug/verification screenshot dumps (hundreds of MB, not deliverables).
# Curated sets are kept: screenshots/final, screenshots/r2-final,
# screenshots/upload, screenshots/r2-upload.
screenshots/r2-raw/
screenshots/r2-play/
screenshots/*.png
